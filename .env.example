# Copy to .env. scripts/register_with_aom.py fills in the AOM_* values for you.

# --- Couchbase Agent Operations Manager -------------------------------------
# AOM as reached from the backend container (AOM's own compose stack, same machine).
AOM_URL=https://host.docker.internal:8090
# The AOM dashboard as your browser reaches it (linked from the story page at https://localhost:5151/story).
AOM_DASHBOARD_URL=https://localhost
# Issued by register_with_aom.py (POST /v1/agents) - the "ShopSmart Shopping Assistant" agent.
AOM_AGENT_API_KEY=
# AOM dashboard admin - used only to publish Knowledge Base documents from the daily export.
AOM_ADMIN_USERNAME=admin
AOM_ADMIN_PASSWORD=
# Optional: pin the LLM AOM routes completions to (otherwise AOM's configured default).
AOM_LLM_PROVIDER=
AOM_LLM_MODEL=
# AOM serves a self-signed cert by default.
AOM_VERIFY_TLS=false

# --- Knowledge Base publishing (daily) ----------------------------------------
# Shopper profiles are published for shoppers who opened the app within this many days.
KB_WINDOW_DAYS=2
KB_PROFILE_LIMIT=150

# --- Sync Gateway URL handed to the phone -------------------------------------
# Leave blank to use the app's EXPO_PUBLIC_SG_URL. For a physical phone use your Mac's LAN IP.
SG_PUBLIC_URL=

# --- Demo clock ----------------------------------------------------------------
# Blank = the export's export_date, so "about to run out" is the same whenever you demo.
DEMO_TODAY=

# --- Databricks offload counter ---------------------------------------------------
# Illustrative cost of one SQL-warehouse / Model Serving query, used by the story page
# to turn "warehouse queries avoided" into dollars. Set it to the customer's real figure.
DBX_COST_PER_QUERY_USD=0.035

APP_SECRET=change-me-for-anything-shared

# --- Dynamic pricing (merchandising console: https://localhost:5151/merch) -----
# Time-of-day promotions run on the wall clock in this zone...
PRICING_TZ=America/New_York
# ...unless you pin the hour (0-23) so the demo looks the same whenever you give it.
# 9 = the morning coffee promotion is on (what the README's demo script assumes). Leave the value
# empty for wall time. The console can move the clock live either way.
DEMO_HOUR=9
# How often inventory is re-read into the pricing rules (orders re-price at once regardless).
PRICING_REFRESH_SECONDS=60

# --- Browser UI (https://localhost:5151) ---------------------------------------
# The sign-in page in front of the app and the story page.
DEMO_USERNAME=demo
DEMO_PASSWORD=Couchbase123!
# Extra host names / IPs for the self-signed certificate (comma-separated).
TLS_HOSTS=
